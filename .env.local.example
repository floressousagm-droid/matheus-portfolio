# Copie este arquivo para .env.local (localmente) ou configure as mesmas
# variáveis nas Environment Variables do projeto na Vercel.

# --- Formulário de contato (Resend) ---
# Veja README.md — seção "Formulário de contato (Resend)".
RESEND_API_KEY=

# --- Painel de edição (/keystatic) ---
# Deixe TODAS as quatro vazias para editar localmente (grava direto nos
# arquivos, sem login). Preencha-as apenas na Vercel, para habilitar o painel
# em produção — aí cada edição vira um commit no GitHub.
# O passo a passo está no README.md — seção "Painel de edição".
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
