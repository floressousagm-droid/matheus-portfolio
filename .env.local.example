# Copie para .env.local (local) ou configure na Vercel (Environment Variables).

# --- Formulário de contato (Resend) ---
# Veja README.md — seção "Formulário de contato".
RESEND_API_KEY=

# --- Painel de edição (/keystatic) ---
# Sem estas variáveis, o painel responde 404 em produção.
# Localmente, sem elas, o painel abre sem senha e grava direto nos arquivos.

# Senha de acesso ao painel. Use algo longo e aleatório.
PAINEL_SENHA=
# Segredo que assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAINEL_SEGREDO=

# --- Gravação via GitHub (só necessário em produção) ---
# Sem NEXT_PUBLIC_GITHUB_REPO o painel grava em arquivo, o que não funciona na
# Vercel (disco somente leitura). Preencha as quatro no ambiente publicado.
# O passo a passo está no README — seção "Painel de edição".
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
